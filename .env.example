# ========================================================
# Accessories Storefront & Admin Configuration Template
# ========================================================

# Application Port
APP_PORT=8080

# Database Configuration (PostgreSQL in Docker)
POSTGRES_DB=accessories
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5433

# Telegram Bot Configuration (for OTP delivery)
BOT_TOKEN=your_telegram_or_bale_bot_token
BOT_API_URL=https://api.telegram.org

# Admin Credentials & Telegram Chat ID (comma-separated if multiple)
ADMIN_MOBILES=09121231234
ADMIN_PASSWORD=change_this_admin_password
ADMIN_CHAT_IDS=1234456

# Seller & Store Contact Info (displayed in Storefront & Telegram CTA buttons)
SELLER_NAME=فروشگاه اکسسوری
SELLER_PHONE=09121231234
SELLER_TELEGRAM=your_telegram_id
SELLER_INSTAGRAM=your_instagram_id
SELLER_BALE=your_bale_id
SELLER_WHATSAPP=09121231234
SELLER_ADDRESS=آدرس فروشگاه

# Local Upload Directory
UPLOAD_DIR=/app/uploads

# Hibernate DDL Auto (update or validate)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
